{
  // Optional overrides for outlook-font. Copy to ~/.hammerspoon/outlook-font.json.
  // Keys you leave out keep their built-in defaults (outlook_font/config.lua),
  // including the localized Outlook labels and menu paths; see README "Configuration".

  // "auto"   = try New Outlook (Settings…) first, then Legacy Outlook (Preferences…)
  // "new"    = force New Outlook only
  // "legacy" = force Legacy Outlook only
  "mode": "auto",

  // Timing for UI automation (seconds)
  "delays": {
    // Wait after bringing Outlook to the front
    "activate": 0.1,
    // Polling interval while waiting for windows or labels
    "waitInterval": 0.05,
    // Give up waiting for a window or pane after this long
    "timeout": 3
  },

  // Retries when opening the menu or interacting with Outlook's UI fails
  "retry": {
    // Retries after the first attempt
    "attempts": 2,
    // Pause between retries (seconds)
    "interval": 0.2
  },

  // On-screen overlay after a change; set "showOverlay" to false to disable it
  "overlayDuration": 1.2,
  "showOverlay": true,

  // Hotkeys (mods: any of "ctrl", "alt", "cmd", "shift"; key: single character).
  // Set "toggle" to false to disable the toggle hotkey.
  "hotkeys": {
    "increase": { "mods": ["ctrl", "alt", "cmd"], "key": "g" },
    "decrease": { "mods": ["ctrl", "alt", "cmd"], "key": "k" },
    "toggle": { "mods": ["ctrl", "alt", "cmd"], "key": "t" }
  }
}
